#!/usr/bin/env python3
"""Derive every host-specific manifest from the portable ones.

Source of truth: plugin.json (Agent Plugins schema, OpenAI metadata under
extensions["com.openai"]) and mcp.json. Generated here so they never drift:

  .codex-plugin/plugin.json   Codex CLI / ChatGPT desktop (interface at top level)
  .claude-plugin/plugin.json  Claude Code
  .cursor-plugin/plugin.json  Cursor / Grok Bot marketplace (logo + MCP path)
  .mcp.json                   Codex, Claude Code, Grok Build, Cursor (mcpServers only)

Run after editing plugin.json or mcp.json:  python3 bin/build-manifests
CI fails if the committed copies are stale.
"""
import json
import pathlib
import sys

root = pathlib.Path(__file__).resolve().parent.parent
plugin = json.loads((root / "plugin.json").read_text())
mcp = json.loads((root / "mcp.json").read_text())
iface = plugin["extensions"]["com.openai"]["interface"]
common = {k: plugin[k] for k in ("name", "version", "description", "author", "homepage", "repository", "license", "keywords") if k in plugin}

# Cursor marketplace logo: relative path without "./" (matches Cursor reference examples).
logo = iface.get("logo", "./assets/logo.png").lstrip("./")

outputs = {
    root / ".codex-plugin" / "plugin.json": {**common, "skills": "./skills/", "interface": iface},
    root / ".claude-plugin" / "plugin.json": {**common, "displayName": iface["displayName"], "skills": "./skills/", "mcpServers": "./.mcp.json"},
    root / ".cursor-plugin" / "plugin.json": {**common, "logo": logo, "skills": "./skills/", "mcpServers": "./.mcp.json"},
    root / ".mcp.json": {"mcpServers": mcp["mcpServers"]},
}

check = "--check" in sys.argv
stale = []
for path, data in outputs.items():
    text = json.dumps(data, indent=2, ensure_ascii=False) + "\n"
    if check:
        if not path.exists() or path.read_text() != text:
            stale.append(str(path.relative_to(root)))
    else:
        path.parent.mkdir(exist_ok=True)
        path.write_text(text)
        print("wrote", path.relative_to(root))
if check and stale:
    print("stale generated manifests (run bin/build-manifests):", ", ".join(stale))
    sys.exit(1)
